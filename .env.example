# RebuildBot environment template
# Copy to .env and adjust. Never commit a real .env file.

# Port the production server binds to (npm start)
PORT=5000

# Port the Next.js dev server binds to (npm run dev)
DEV_PORT=5173

# Set to "production" when running the built app
NODE_ENV=production

# Disable Next.js telemetry so offline builds never reach the network
NEXT_TELEMETRY_DISABLED=1

# Repository this deployment should score when the input box is left empty.
# On Vercel this is detected automatically from VERCEL_GIT_REPO_OWNER and
# VERCEL_GIT_REPO_SLUG. Set it manually on any other host.
# SELF_REPO_URL=https://github.com/owner/repo
