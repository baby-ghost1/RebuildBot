{
  "name": "rebuildbot",
  "version": "1.0.0",
  "description": "RebuildBot - Analyzes any repo for Buildathon rebuild-readiness and shows a live score",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node src/server/index.js\" \"vite --port 5173\"",
    "server": "node src/server/index.js",
    "client": "vite --port 5173",
    "build": "vite build",
    "start": "node src/server/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
