{
  "name": "rebuildbot",
  "version": "2.0.0",
  "description": "RebuildBot — Next.js app that checks any repo for Buildathon rebuild-readiness",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "node scripts/start.js",
    "serve": "node scripts/serve.js start",
    "serve:dev": "node scripts/serve.js start dev",
    "serve:stop": "node scripts/serve.js stop",
    "serve:status": "node scripts/serve.js status",
    "serve:restart": "node scripts/serve.js restart",
    "keepalive": "node scripts/keepalive.js",
    "ping": "node scripts/keepalive.js",
    "test": "jest --ci --runInBand"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.3"
  }
}
